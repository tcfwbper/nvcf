load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "nvsnap-helper_lib",
    srcs = [
        "main.go",
        "modelcache.go",
        "pidfloor.go",
    ],
    importpath = "github.com/dsx-ai-factory/nvcf/src/compute-plane-services/nvsnap/cmd/nvsnap-helper",
    visibility = ["//visibility:private"],
    deps = ["//src/compute-plane-services/nvsnap/internal/modelcache"],
)

go_binary(
    name = "nvsnap-helper",
    embed = [":nvsnap-helper_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "nvsnap-helper_test",
    srcs = [
        "main_test.go",
        "modelcache_test.go",
        "pidfloor_test.go",
    ],
    embed = [":nvsnap-helper_lib"],
    deps = ["//src/compute-plane-services/nvsnap/internal/modelcache"],
)
