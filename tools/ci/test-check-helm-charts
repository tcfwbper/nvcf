#
# Behavioral test for tools/ci/check-helm-charts.
#
# The point of the chart values map (tools/ci/helm-chart-values.yaml) is that
# an unwired values file cannot land silently, so assert the failure directly. A wiring loop that never fails is
# indistinguishable from no loop at all. Each case builds a throwaway values
# directory instead of depending on the real one, so these stay true as charts
# come and go.
#
# The wiring cases run before helm is invoked, so they need no helm. The
# cleanup cases stub helm instead of installing it. Every case needs yq v4,
# which check-helm-charts uses to read the map.
set -euo pipefail

script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/check-helm-charts"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
real_map="${repo_root}/tools/ci/helm-chart-values.yaml"
fail=0

run() {  # run <values-dir> [repo-root] [map] -> sets $out and $rc
    local values_dir="$1" root="${2:-${repo_root}}" map="${3:-${real_map}}"
    set +e
    out="$(bash "${script}" --values-dir "${values_dir}" --repo-root "${root}" --map "${map}" 2>&1)"
    rc=$?
    set -e
}

expect() {  # expect <desc> <want-rc> [substring]
    local desc="$1" want="$2" substr="${3:-}"
    if [ "${rc}" != "${want}" ]; then
        printf 'FAIL %s: want exit %s, got %s\n%s\n' "${desc}" "${want}" "${rc}" "${out}"
        fail=1
        return
    fi
    if [ -n "${substr}" ] && ! printf '%s' "${out}" | grep -q -- "${substr}"; then
        printf 'FAIL %s: output missing %q\n%s\n' "${desc}" "${substr}" "${out}"
        fail=1
        return
    fi
    printf 'ok   %s\n' "${desc}"
}

# A values file with no map entry must fail, and must name the file.
d="$(mktemp -d)"
touch "${d}/brand-new-service.yaml"
run "${d}"
expect "unmapped values file fails" 1 "brand-new-service.yaml has no chart mapping"
rm -rf "${d}"

# A map entry whose chart directory is gone must fail.
d="$(mktemp -d)"
empty_root="$(mktemp -d)"
touch "${d}/cassandra.yaml"
printf 'scenarios:\n  - {chart: deploy/helm/cassandra/helm, values: cassandra.yaml}\n' >"${empty_root}/map.yaml"
run "${d}" "${empty_root}" "${empty_root}/map.yaml"
expect "missing chart directory fails" 1 "which has no Chart.yaml"
rm -rf "${d}" "${empty_root}"

# A map entry whose values file is gone must fail.
d="$(mktemp -d)"
m="$(mktemp -d)"
touch "${d}/cassandra.yaml"
printf 'scenarios:\n  - {chart: deploy/helm/cassandra/helm, values: cassandra.yaml}\n  - {chart: deploy/helm/cassandra/helm, values: gone.yaml}\n' >"${m}/map.yaml"
run "${d}" "${repo_root}" "${m}/map.yaml"
expect "stale map entry fails" 1 "map entry 'gone.yaml' has no"
rm -rf "${d}" "${m}"

# An entry missing a field must fail rather than be skipped.
d="$(mktemp -d)"
m="$(mktemp -d)"
touch "${d}/cassandra.yaml"
printf 'scenarios:\n  - {chart: deploy/helm/cassandra/helm, values: cassandra.yaml}\n  - {chart: deploy/helm/cassandra/helm}\n' >"${m}/map.yaml"
run "${d}" "${repo_root}" "${m}/map.yaml"
expect "incomplete map entry fails" 1 "needs both 'chart' and 'values'"
rm -rf "${d}" "${m}"

# A map without a scenarios list must fail.
d="$(mktemp -d)"
m="$(mktemp -d)"
touch "${d}/cassandra.yaml"
printf 'cassandra: deploy/helm/cassandra/helm\n' >"${m}/map.yaml"
run "${d}" "${repo_root}" "${m}/map.yaml"
expect "map without scenarios list fails" 1 "must hold a 'scenarios' list"
printf 'scenarios: []\n' >"${m}/map.yaml"
run "${d}" "${repo_root}" "${m}/map.yaml"
expect "empty scenarios list fails" 1 "has no scenarios"
rm -rf "${d}" "${m}"

# A yq that is not mikefarah/yq v4 (for example the Python wrapper) must fail
# with install guidance instead of misreading the map.
d="$(mktemp -d)"
stub="$(mktemp -d)"
touch "${d}/cassandra.yaml"
printf '#!/usr/bin/env bash\necho "yq 3.4.3"\n' >"${stub}/yq"
chmod +x "${stub}/yq"
set +e
out="$(PATH="${stub}:${PATH}" bash "${script}" --values-dir "${d}" 2>&1)"
rc=$?
set -e
expect "missing yq v4 fails with guidance" 1 "yq v4 (github.com/mikefarah/yq) not found"
rm -rf "${d}" "${stub}"

# An empty values directory must fail rather than report success over nothing.
d="$(mktemp -d)"
run "${d}"
expect "empty values directory fails" 1 "no values files in"
rm -rf "${d}"

# --repo-root alone moves the derived values directory and map with it.
empty_root="$(mktemp -d)"
set +e
out="$(bash "${script}" --repo-root "${empty_root}" 2>&1)"
rc=$?
set -e
expect "repo root alone derives the values directory" 1 "values directory not found: ${empty_root}/tools/ci/helm-validate-values"
rm -rf "${empty_root}"

# A missing values directory must fail.
run "/nonexistent/helm-validate-values"
expect "missing values directory fails" 1 "values directory not found"

# ---------------------------------------------------------------------------
# Dependency cleanup
#
# helm dependency build writes charts/*.tgz into the working tree. Stub helm so
# these cases assert the cleanup without a network fetch, and satisfy the real
# map so the run reaches helm at all.
# ---------------------------------------------------------------------------

fake_values_dir=""
fake_chart_root=""
fake_chart_count=0

make_fake_tree() {  # sets $fake_values_dir, $fake_chart_root, and $fake_chart_count from the real map
    local rel values
    fake_values_dir="$(mktemp -d)"
    fake_chart_root="$(mktemp -d)"
    fake_chart_count=0
    while read -r rel values; do
        [ -n "${rel}" ] || continue
        : >"${fake_values_dir}/${values}"
        mkdir -p "${fake_chart_root}/${rel}"
        printf 'apiVersion: v2\nname: %s\nversion: 0.0.0\n' "$(basename "${rel}")" \
            >"${fake_chart_root}/${rel}/Chart.yaml"
        fake_chart_count=$((fake_chart_count + 1))
    done < <(yq -r '.scenarios[] | .chart + " " + .values' "${real_map}")
    if [ ! -f "${fake_chart_root}/deploy/helm/openbao/helm/Chart.yaml" ]; then
        printf 'FAIL fake tree: the map did not yield the expected entries\n'
        fail=1
    fi
}

make_fake_helm() {  # make_fake_helm -> directory holding a helm stub, printed to stdout
    local dir; dir="$(mktemp -d)"
    cat >"${dir}/helm" <<'STUB'
#!/usr/bin/env bash
# Stub helm: dependency build drops an archive and logs the chart, everything
# else succeeds.
if [ "${1:-}" = "dependency" ]; then
    echo "${3}" >>"${FAKE_HELM_BUILD_LOG:-/dev/null}"
    mkdir -p "${3}/charts"
    : >"${3}/charts/fetched-0.1.0.tgz"
fi
exit 0
STUB
    chmod +x "${dir}/helm"
    printf '%s' "${dir}"
}

run_with_fake_helm() {  # run_with_fake_helm -> sets $out and $rc
    local stub_dir; stub_dir="$(make_fake_helm)"
    set +e
    out="$(PATH="${stub_dir}:${PATH}" bash "${script}" \
        --values-dir "${fake_values_dir}" --repo-root "${fake_chart_root}" --map "${real_map}" 2>&1)"
    rc=$?
    set -e
    rm -rf "${stub_dir}"
}

# A rendered document whose apiVersion was swallowed into a comment must fail
# the chart, naming the file line. helm itself accepts this output, which is
# how the container-cache Service shipped without an apiVersion in 0.29.0.
make_fake_glued_helm() {  # make_fake_glued_helm -> directory holding a helm stub, printed to stdout
    local dir; dir="$(mktemp -d)"
    cat >"${dir}/helm" <<'STUB'
#!/usr/bin/env bash
# Stub helm: template emits one good document and one whose apiVersion was
# trimmed onto the preceding comment line.
if [ "${1:-}" = "template" ]; then
    printf -- '---\n# Source: x/templates/a.yaml\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: good\n'
    printf -- '---\n# Source: x/templates/b.yaml\n# limitations under the License.apiVersion: v1\nkind: Service\nmetadata:\n  name: glued\n'
fi
exit 0
STUB
    chmod +x "${dir}/helm"
    printf '%s' "${dir}"
}

make_fake_headless_helm() {  # make_fake_headless_helm -> stub whose template emits a document with no apiVersion at all
    local dir; dir="$(mktemp -d)"
    cat >"${dir}/helm" <<'STUB'
#!/usr/bin/env bash
if [ "${1:-}" = "template" ]; then
    printf -- '---\n# Source: x/templates/a.yaml\nkind: Service\nmetadata:\n  name: headless\nspec: {}\n'
fi
exit 0
STUB
    chmod +x "${dir}/helm"
    printf '%s' "${dir}"
}

make_fake_tree
stub_dir="$(make_fake_glued_helm)"
set +e
out="$(PATH="${stub_dir}:${PATH}" bash "${script}" --values-dir "${fake_values_dir}" --repo-root "${fake_chart_root}" --map "${real_map}" 2>&1)"
rc=$?
set -e
rm -rf "${stub_dir}"
expect "apiVersion glued onto a comment fails" 1 "rendered onto a comment line"
rm -rf "${fake_values_dir}" "${fake_chart_root}"

make_fake_tree
stub_dir="$(make_fake_headless_helm)"
set +e
out="$(PATH="${stub_dir}:${PATH}" bash "${script}" --values-dir "${fake_values_dir}" --repo-root "${fake_chart_root}" --map "${real_map}" 2>&1)"
rc=$?
set -e
rm -rf "${stub_dir}"
expect "document without apiVersion fails" 1 "has no top-level apiVersion"
rm -rf "${fake_values_dir}" "${fake_chart_root}"

# A charts/ directory created by the run is removed entirely.
make_fake_tree
printf 'dependencies:\n  - name: openbao\n' >>"${fake_chart_root}/deploy/helm/openbao/helm/Chart.yaml"
run_with_fake_helm
expect "fetched charts directory is removed" 0 "${fake_chart_count} scenarios linted and rendered"
if [ -e "${fake_chart_root}/deploy/helm/openbao/helm/charts" ]; then
    printf 'FAIL created charts directory left behind\n'
    fail=1
else
    printf 'ok   created charts directory removed\n'
fi
rm -rf "${fake_values_dir}" "${fake_chart_root}"

# An existing charts/ directory keeps its contents and loses only the fetch.
# helm dependency build adds to charts/ rather than replacing it, so removing
# the whole directory would delete a vendored subchart.
make_fake_tree
printf 'dependencies:\n  - name: openbao\n' >>"${fake_chart_root}/deploy/helm/openbao/helm/Chart.yaml"
mkdir -p "${fake_chart_root}/deploy/helm/openbao/helm/charts/vendored-subchart"
: >"${fake_chart_root}/deploy/helm/openbao/helm/charts/vendored-0.1.0.tgz"
run_with_fake_helm
expect "existing charts directory run succeeds" 0 "${fake_chart_count} scenarios linted and rendered"
if [ -e "${fake_chart_root}/deploy/helm/openbao/helm/charts/fetched-0.1.0.tgz" ]; then
    printf 'FAIL fetched archive left in an existing charts directory\n'
    fail=1
else
    printf 'ok   fetched archive removed from an existing charts directory\n'
fi
if [ -f "${fake_chart_root}/deploy/helm/openbao/helm/charts/vendored-0.1.0.tgz" ] &&
   [ -d "${fake_chart_root}/deploy/helm/openbao/helm/charts/vendored-subchart" ]; then
    printf 'ok   vendored charts directory contents preserved\n'
else
    printf 'FAIL cleanup removed pre-existing charts directory contents\n'
    fail=1
fi
rm -rf "${fake_values_dir}" "${fake_chart_root}"

# A chart with several scenarios fetches its dependencies once.
make_fake_tree
multi="$(yq -r '[.scenarios[].chart] | group_by(.) | map(select(length > 1)) | .[0][0] // ""' "${real_map}")"
if [ -z "${multi}" ]; then
    printf 'FAIL the real map has no chart with several scenarios to exercise\n'
    fail=1
else
    printf 'dependencies:\n  - name: fixture\n' >>"${fake_chart_root}/${multi}/Chart.yaml"
    build_log="$(mktemp)"
    FAKE_HELM_BUILD_LOG="${build_log}" run_with_fake_helm
    expect "multi-scenario chart run succeeds" 0 "${fake_chart_count} scenarios linted and rendered"
    if [ "$(wc -l <"${build_log}" | tr -d ' ')" = "1" ]; then
        printf 'ok   multi-scenario chart dependencies built once\n'
    else
        printf 'FAIL multi-scenario chart dependency builds:\n%s\n' "$(cat "${build_log}")"
        fail=1
    fi
    rm -f "${build_log}"
fi
rm -rf "${fake_values_dir}" "${fake_chart_root}"

exit "${fail}"
