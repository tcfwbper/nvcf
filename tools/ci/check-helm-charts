#
# Lint and render every chart that has a CI values file.
#
# tools/ci/helm-validate-values/<name>.yaml holds one CI-only values scenario.
# tools/ci/helm-chart-values.yaml maps each scenario to its chart directory
# (relative to the repository root); one chart may have several scenarios.
# Both directions are checked: a values file with no entry fails, and an entry
# whose values file or chart directory is gone fails. Otherwise a new values
# file could land with nothing validating it.
#
# Every scenario runs even after one fails, so a single run reports every
# broken chart instead of only the first.
#
# Requires yq v4 (to read the map) and helm v3.
#
# Usage:
#   tools/ci/check-helm-charts
#   tools/ci/check-helm-charts --values-dir DIR --map FILE --repo-root DIR
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/../.." && pwd)"
values_dir=""
map_file=""

while [ $# -gt 0 ]; do
    case "$1" in
        --values-dir) values_dir="$2"; shift 2 ;;
        --map) map_file="$2"; shift 2 ;;
        --repo-root) repo_root="$2"; shift 2 ;;
        -h|--help)
            echo "usage: check-helm-charts [--values-dir DIR] [--map FILE] [--repo-root DIR]"
            exit 0
            ;;
        *) echo "check-helm-charts: unknown argument '$1'" >&2; exit 2 ;;
    esac
done

# Derived after parsing so --repo-root alone moves the map and values too.
values_dir="${values_dir:-${repo_root}/tools/ci/helm-validate-values}"
map_file="${map_file:-${repo_root}/tools/ci/helm-chart-values.yaml}"

# ---------------------------------------------------------------------------
# Wiring: every values file maps to a chart, and every mapping is still live.
# ---------------------------------------------------------------------------

if ! command -v yq >/dev/null 2>&1 || ! yq --version 2>/dev/null | grep -q 'mikefarah'; then
    echo "check-helm-charts: yq v4 (github.com/mikefarah/yq) not found on PATH." >&2
    echo "  Install the version pinned as YQ_VERSION in .github/workflows/build-test.yml" >&2
    echo "  from https://github.com/mikefarah/yq/releases, or with" >&2
    echo "  'go install github.com/mikefarah/yq/v4@v<YQ_VERSION>'." >&2
    exit 1
fi

if [ ! -d "${values_dir}" ]; then
    echo "check-helm-charts: values directory not found: ${values_dir}" >&2
    exit 1
fi
if [ ! -f "${map_file}" ]; then
    echo "check-helm-charts: chart values map not found: ${map_file}" >&2
    exit 1
fi

values_files=()
while IFS= read -r path; do
    values_files+=("$(basename "${path}")")
done < <(find "${values_dir}" -maxdepth 1 -type f -name '*.yaml' | sort)

if [ "${#values_files[@]}" -eq 0 ]; then
    echo "check-helm-charts: no values files in ${values_dir}" >&2
    exit 1
fi

# One "<chart dir> <values file>" line per entry. A missing field becomes an
# empty string so the entry is reported below instead of silently dropped.
if ! map_lines="$(yq -r '.scenarios[] | (.chart // "") + " " + (.values // "")' "${map_file}")" ||
   [ "$(yq -r '.scenarios | tag' "${map_file}")" != "!!seq" ]; then
    echo "check-helm-charts: ${map_file} must hold a 'scenarios' list of {chart, values} entries." >&2
    exit 1
fi
if [ -z "${map_lines}" ]; then
    echo "check-helm-charts: ${map_file} has no scenarios." >&2
    exit 1
fi

entry_charts=()
entry_values=()
while IFS=' ' read -r chart values; do
    entry_charts+=("${chart}")
    entry_values+=("${values}")
done <<<"${map_lines}"

wiring_errors=0

for file in "${values_files[@]}"; do
    mapped=0
    for values in "${entry_values[@]}"; do
        [ "${values}" = "${file}" ] && mapped=1 && break
    done
    if [ "${mapped}" -eq 0 ]; then
        echo "check-helm-charts: ${file} has no chart mapping." >&2
        echo "  Add '- {chart: <chart dir from repo root>, values: ${file}}' to ${map_file}." >&2
        wiring_errors=1
    fi
done

for i in "${!entry_charts[@]}"; do
    chart="${entry_charts[$i]}"
    values="${entry_values[$i]}"
    if [ -z "${chart}" ] || [ -z "${values}" ]; then
        echo "check-helm-charts: map entry $((i + 1)) needs both 'chart' and 'values'." >&2
        wiring_errors=1
        continue
    fi
    if [ ! -f "${values_dir}/${values}" ]; then
        echo "check-helm-charts: map entry '${values}' has no ${values_dir}/${values}." >&2
        echo "  Remove the stale entry or restore the values file." >&2
        wiring_errors=1
    fi
    if [ ! -f "${repo_root}/${chart}/Chart.yaml" ]; then
        echo "check-helm-charts: map entry '${values}' points at ${repo_root}/${chart}, which has no Chart.yaml." >&2
        echo "  Update the entry to the chart's current directory." >&2
        wiring_errors=1
    fi
done

if [ "${wiring_errors}" -ne 0 ]; then
    exit 1
fi

# ---------------------------------------------------------------------------
# Lint and render.
# ---------------------------------------------------------------------------

if ! command -v helm >/dev/null 2>&1; then
    echo "check-helm-charts: 'helm' not found on PATH." >&2
    echo "  Install helm v3.x from https://helm.sh/docs/intro/install/." >&2
    exit 1
fi

# helm dependency build writes charts/*.tgz into the working tree, and adds to
# an existing charts/ directory rather than replacing it. deploy/helm already
# has charts/ directories holding vendored subchart sources, so removing the
# whole directory is not safe. Record the archives present before each fetch
# and delete only the ones this run added, plus any charts/ directory it
# created outright. A dirty tree then never leaks into a commit.
created_dirs=()
fetched_archives=()

archives_in() {  # archives_in <chart dir> -> one archive path per line
    find "$1/charts" -maxdepth 1 -type f -name '*.tgz' 2>/dev/null | sort
}

record_new_archives() {  # record_new_archives <chart dir> <before list>
    local chart_dir="$1" before="$2" archive
    while IFS= read -r archive; do
        [ -n "${archive}" ] || continue
        case $'\n'"${before}"$'\n' in
            *$'\n'"${archive}"$'\n'*) continue ;;
        esac
        fetched_archives+=("${archive}")
    done < <(archives_in "${chart_dir}")
}

cleanup() {
    local path
    for path in ${fetched_archives[@]+"${fetched_archives[@]}"}; do
        rm -f "${path}"
    done
    for path in ${created_dirs[@]+"${created_dirs[@]}"}; do
        rm -rf "${path}"
    done
}
trap cleanup EXIT

run_step() {  # run_step <label> <command...> -> 0 on success, prints output on failure
    local label="$1"; shift
    local output status=0
    output="$("$@" 2>&1)" || status=$?
    if [ "${status}" -ne 0 ]; then
        printf 'FAIL %s\n' "${label}"
        printf '%s\n' "${output}" | sed 's/^/     /'
        return 1
    fi
    return 0
}

# helm template and helm lint accept a document whose apiVersion has been
# swallowed into a preceding comment (a template action ending in "-}}" right
# after the license header does this), because the line is valid YAML. The
# API server and ArgoCD then reject the object ("groupVersion shouldn't be
# empty"). Check every rendered document for a top-level apiVersion and kind.
check_rendered_objects() {  # check_rendered_objects <stem> <rendered file>
    local stem="$1" rendered="$2"
    # Document-aware: a comment that merely mentions "kind:" is fine. Only when
    # the same document lacks the top-level field is the comment line reported,
    # as the likely place the field was trimmed onto.
    awk -v stem="${stem}" '
        function flush() {
            if (content) {
                if (!hasapi) report("apiVersion", gluedapi)
                if (!haskind) report("kind", gluedkind)
            }
            content = 0; hasapi = 0; haskind = 0; gluedapi = 0; gluedkind = 0; name = "?"; n++
        }
        function report(field, glued) {
            bad++
            if (glued) {
                printf "%s: rendered document %d (%s) has no top-level %s; line %d has %s rendered onto a comment line (a template action ending in -}} trimmed the newline)\n", stem, n, name, field, glued, field > "/dev/stderr"
            } else {
                printf "%s: rendered document %d (%s) has no top-level %s\n", stem, n, name, field > "/dev/stderr"
            }
        }
        BEGIN { n = 1; name = "?" }
        /^---/ { flush(); next }
        /^[ \t]*#/ {
            if ($0 ~ /apiVersion:/ && !gluedapi) gluedapi = NR
            if ($0 ~ /kind:/ && !gluedkind) gluedkind = NR
            next
        }
        /^[ \t]*$/ { next }
        { content = 1 }
        /^apiVersion:/ { hasapi = 1 }
        /^kind:/ { haskind = 1 }
        /^  name:/ && name == "?" { name = $2 }
        END {
            flush()
            exit (bad ? 1 : 0)
        }
    ' "${rendered}"
}

render_and_check() {  # render_and_check <stem> <chart dir> <values file>
    local stem="$1" chart_dir="$2" values_file="$3" rendered
    rendered="$(mktemp)"
    if ! helm template "${stem}" "${chart_dir}" -f "${values_file}" >"${rendered}"; then
        rm -f "${rendered}"
        return 1
    fi
    check_rendered_objects "${stem}" "${rendered}"
    local rc=$?
    rm -f "${rendered}"
    return "${rc}"
}

failed=()
built_charts=" "

for i in "${!entry_charts[@]}"; do
    chart="${entry_charts[$i]}"
    chart_dir="${repo_root}/${chart}"
    values_file="${values_dir}/${entry_values[$i]}"
    stem="${entry_values[$i]%.yaml}"
    chart_failed=0

    # A chart with several scenarios fetches its dependencies once.
    if grep -qE '^dependencies:' "${chart_dir}/Chart.yaml" &&
       [[ "${built_charts}" != *" ${chart} "* ]]; then
        built_charts+="${chart} "
        # The chart declares subcharts. helm lint only warns when they are
        # absent, so without this fetch helm template fails on a missing
        # dependency and lint alone would not have caught it.
        before_archives=""
        if [ -d "${chart_dir}/charts" ]; then
            before_archives="$(archives_in "${chart_dir}")"
        else
            created_dirs+=("${chart_dir}/charts")
        fi
        run_step "${stem}: helm dependency build" \
            helm dependency build "${chart_dir}" || chart_failed=1
        # Record after a failed fetch too. helm can leave a partial download
        # behind on error.
        record_new_archives "${chart_dir}" "${before_archives}"
    fi

    if [ "${chart_failed}" -eq 0 ]; then
        run_step "${stem}: helm lint" \
            helm lint "${chart_dir}" -f "${values_file}" || chart_failed=1
        run_step "${stem}: helm template" \
            render_and_check "${stem}" "${chart_dir}" "${values_file}" || chart_failed=1
    fi

    if [ "${chart_failed}" -eq 0 ]; then
        printf 'ok   %s (%s)\n' "${stem}" "${chart}"
    else
        failed+=("${stem}")
    fi
done

echo
if [ "${#failed[@]}" -ne 0 ]; then
    printf 'check-helm-charts: %d of %d scenarios failed: %s\n' \
        "${#failed[@]}" "${#entry_charts[@]}" "${failed[*]}" >&2
    exit 1
fi

printf 'check-helm-charts: %d scenarios linted and rendered\n' "${#entry_charts[@]}"
